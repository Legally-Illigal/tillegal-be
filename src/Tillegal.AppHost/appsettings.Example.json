{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=tillegal_dev;Username=postgres;Password=postgres"
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Jwt": {
    "Issuer": "TillegalBackend",
    "Audience": "TillegalClient",
    "SigningKey": "YourSuperSecretSigningKeyThatIsAtLeast32BytesLong!",
    "ExpirationMinutes": 60
  },
  "GoogleAuth": {
    "ClientId": "your-google-oauth-client-id.apps.googleusercontent.com"
  },
  "Upstash": {
    "RedisRestUrl": "https://your-upstash-redis.upstash.io",
    "RedisRestToken": "your_upstash_rest_token"
  },
  "Resend": {
    "ApiKey": "re_your_resend_api_key",
    "FromEmail": "noreply@tillegal.com"
  },
  "Supabase": {
    "Url": "https://your-supabase-project.supabase.co",
    "Bucket": "tillegal-storage",
    "ServiceKey": "your_supabase_service_role_key"
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "BackgroundJobs": {
    "TimeZone": "Asia/Ho_Chi_Minh"
  },
  "AiService": {
    "BaseUrl": "http://127.0.0.1:8000",
    "ConsultationEndpoint": "/consultation",
    "DefaultWorkflowMode": "single_agent",
    "LawyerWorkflowMode": "multi_agent"
  }
}
