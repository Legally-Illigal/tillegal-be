# .gitignore for a .NET 10 solution (Windows environment)
# ------------------------------------------------------------
# OS generated files
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Build results
**/bin/
**/obj/
**/out/
**/publish/

# Visual Studio / Rider / VS Code
.VS
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.dotCover
*.csproj.user
*.vcxproj.user
*.vcxproj.filters
*_i.c
*_p.c
*_h.h
*.pdb
*.vspscc
*.vssscc
*.ncb
*.sdf
*.opensdf
*.cache
*.log
*.tcoproj
*.tco
*.tlog
*.vspscc
*.suo
*.sdf
*.VC.db

# NuGet packages
*.nupkg
packages/
.nuget/

# Resharper / JetBrains
_ReSharper.Caches/
*.DotSettings.user

# Rider
.idea/
*.sln.iml

# Coverage reports
coverage*
*.coverage
*.coveragexml
*.lcov

# Test results
TestResults/
*.trx
*.results

# Publish output (already ignored above)
publish/

# Azure / Docker artifacts (if any)
*.dockerfile
Dockerfile
*.dockerignore

# User secrets (ASP.NET Core)
secrets.json
appsettings.*.json

# Local configuration files
local.settings.json

# Misc
*.bak
*.tmp
*.log
*.vspscc
*.vssscc
